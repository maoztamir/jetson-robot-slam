# AWS IoT Core
AWS_IOT_ENDPOINT=your-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_CERT=certs/certificate.pem.crt
AWS_IOT_KEY=certs/private.pem.key
AWS_IOT_ROOT_CA=certs/AmazonRootCA1.pem
AWS_IOT_THING=jetson-robot

# ORB_SLAM3
ORB_SLAM3_ROOT=/opt/ORB_SLAM3
ORB_SLAM3_VOCAB=/opt/ORB_SLAM3/Vocabulary/ORBvoc.txt

# Camera
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
